+/// The tiles that cover a `width` by `height` bitmap, row by row.
+fn tile_rects(width: u16, height: u16) -> Vec<TileRect> {
+    let step = usize::from(TILE_SIZE);
+    (0..height)
+        .step_by(step)
+        .flat_map(|y| {
+            (0..width)
+                .step_by(step)
+                .map(move |x| (x, y, TILE_SIZE.min(width - x), TILE_SIZE.min(height - y)))
+        })
+        .collect()
+}
 
