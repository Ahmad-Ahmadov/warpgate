# Copy to `.env` before the first `docker compose up`:
#
#     cp .env.example .env
#
# The password for the built-in `admin` account. REQUIRED on the first run,
# while ./data holds no warpgate.yaml: without it, first-time setup refuses and
# the gateway does not start. An empty value is refused as well. Setup stores
# only a hash, and after the first run this variable is never read again, so
# you can delete it from .env. To change the password later, use the admin UI.
WARPGATE_ADMIN_PASSWORD=

# The external host is no longer set here. Leave it unset unless you serve HTTP
# targets; then edit `external_host` in data/warpgate.yaml and run
# `docker compose restart warpgate`. It must be exactly the host in your users'
# address bar, or the browser discards every session cookie. See README.md.
